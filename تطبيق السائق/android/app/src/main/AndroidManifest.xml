<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- الموقع: تقريبي ودقيق معاً.
         أندرويد ١٢ فما فوق يعرض للمستخدم خياراً بين "دقيق" و"تقريبي"،
         ولا يظهر الخيار إن لم نطلب الاثنين. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- الكاميرا للصورة الحية. image_picker يفتح تطبيق الكاميرا بنيّة
         نظامية فلا يحتاج الإذن تقنياً، لكن بعض أجهزة شاومي تطلبه. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!-- استعلام عن تطبيقات الملاحة قبل عرضها للسائق.
         أندرويد ١١ فما فوق يخفي التطبيقات المثبّتة ما لم تُعلَن هنا،
         فبدونها يفشل canLaunchUrl دائماً ويبدو Waze غير مثبَّت. -->
    <queries>
        <package android:name="com.waze" />
        <package android:name="com.google.android.apps.maps" />
        <package android:name="app.organicmaps" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <!-- السائق يحتاج الموقع والشاشة مطفأة أو وهو في تطبيق الملاحة،
         وإلا استبعده الخادم بعد ٩٠ ثانية.
         **ولا نطلب ACCESS_BACKGROUND_LOCATION.** الخدمة الأمامية بنوع
         `location` تكفي ما دامت تبدأ والتطبيق مرئي — وهو حالنا: التتبّع
         يبدأ حين يضغط السائق «اتصال» وهو ينظر إلى الشاشة. وطلبُ ذلك
         الإذن يستدعي من جوجل نموذج إفصاح خاص وفيديو ومراجعة تمتد
         أسابيع، بلا مقابل نحتاجه. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- إبقاء الشاشة مضاءة أثناء الرحلة (wakelock_plus) -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- أندرويد ١٣ فما فوق يتطلب إذناً صريحاً للإشعارات.
         بدونه تُرسل الرسائل بنجاح ولا تظهر شيئاً — فشل صامت يصعب تشخيصه. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- **استثناء التطبيق من تجميد البطارية.**
         رصدنا على شاومي أن النظام يجمّد التطبيق (UidFrozen) رغم أن
         الخدمة الأمامية بنوع `location` تعمل. والتجميد يعلّق طلبات
         الشبكة، فيدور زر قبول الطلب بلا نهاية، ويتوقف إرسال الموقع
         فيستبعد الخادمُ السائقَ بعد دقيقتين وهو يحسب نفسه متصلاً.
         التصريح لا يمنح شيئاً بنفسه — يسمح للتطبيق بأن **يطلب**
         الاستثناء، فيفتح للسائق شاشة النظام بزرّ واحد بدل مسار إعدادات
         يختلف بين شاومي وأوبو وسامسونغ. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />


    <!-- واتساب: أندرويد ١١ فما فوق يخفي التطبيقات المثبّتة ما لم تُعلَن
         هنا، فبدونها يفتح رابط wa.me في المتصفح بدل التطبيق. -->
    <queries>
        <package android:name="com.whatsapp" />
        <package android:name="com.whatsapp.w4b" />
    </queries>

    <application
        android:label="${appLabel}"
        android:name="${applicationName}"
        android:icon="@mipmap/zanbour_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
