# =============================================================================
# زنبور — تطبيق الراكب : متغيرات البيئة
# =============================================================================
# انسخ هذا الملف إلى .env واملأ القيم الحقيقية:
#
#   cp .env.example .env
#
# ملف .env مستبعد من git ولا يُرفع إطلاقاً. هذا الملف (.env.example) هو
# القالب المرجعي ويُرفع، فلا تضع فيه قيماً حقيقية أبداً.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase — من لوحة المشروع: Settings → API
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# المفتاح العام (anon). آمن داخل التطبيق لأن سياسات RLS هي خط الدفاع الفعلي.
SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ لا تضع service_role key هنا ولا في أي ملف داخل التطبيق إطلاقاً.
# ذلك المفتاح يتجاوز كل سياسات الأمان، ومن يستخرجه من ملف APK يملك
# قاعدة بياناتك كاملة. مكانه الوحيد هو الخادم أو Edge Functions.

# -----------------------------------------------------------------------------
# خرائط جوجل — من Google Cloud Console
# -----------------------------------------------------------------------------
# مفتاح منفصل لكل منصة، ومُقيَّد ببصمة التطبيق. المفتاح غير المقيَّد
# يستطيع أي شخص استخدامه على حسابك.
GOOGLE_MAPS_API_KEY_ANDROID=AIza...
GOOGLE_MAPS_API_KEY_IOS=AIza...

# -----------------------------------------------------------------------------
# إعدادات عامة
# -----------------------------------------------------------------------------
# dev أثناء التطوير، prod عند الإصدار
APP_ENV=dev
